---
import { getCollection } from 'astro:content';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

const entries = await getCollection('study');
const modules = [...new Set(entries.map((e) => e.data.module))];

interface Props {
  title?: string;
  module?: string;
}

const { title = 'GitHub Actions Study Hub', module } = Astro.props;

const currentModuleEntries = entries.filter((e) => e.data.module === module);
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} | GitHub Actions Study Hub</title>
    <meta
      name="description"
      content="Free study notes, examples, and exercises for the GitHub Actions certification."
    />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://unpkg.com/mermaid@10.9.1/dist/mermaid.min.js"></script>
    <script>
      mermaid.initialize({ startOnLoad: true, theme: 'base' });
    </script>
    <style>
      body {
        @apply bg-github-dark text-white;
      }
      .mermaid {
        @apply bg-white text-black p-4 rounded-lg my-6;
      }
      .mermaid .mermaidSVG {
        @apply bg-white;
      }
      code {
        @apply bg-gray-800 text-yellow-100 px-1.5 py-0.5 rounded;
      }
      pre code {
        @apply block p-4 rounded-lg overflow-x-auto text-sm;
      }
      .copy-btn {
        @apply absolute top-2 right-2 bg-gray-700 hover:bg-gray-600 text-xs text-white px-2 py-1 rounded opacity-0 transition;
      }
      .code-block:hover .copy-btn {
        @apply opacity-100;
      }
      .code-block {
        @apply relative;
      }
      .exam-card {
        @apply border border-gray-700 rounded-xl p-6 transition cursor-pointer;
      }
      .exam-card:hover {
        @apply border-blue-500;
      }
    </style>
  </head>
  <body class="antialiased min-h-screen flex flex-col">
    <Nav modules={modules} />
    <main class="flex-grow container mx-auto px-4 py-8 max-w-5xl">
      <slot />
    </main>
    <Footer />
  </body>
</html>
