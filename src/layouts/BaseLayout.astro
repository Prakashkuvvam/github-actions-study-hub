---
interface Props {
  title?: string;
  module?: string;
}

const { title = 'GitHub Actions Study Hub', module } = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} | GitHub Actions Study Hub</title>
    <meta
      name="description"
      content="Free study notes, examples, and exercises for the GitHub Actions certification."
    />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://unpkg.com/mermaid@10.9.1/dist/mermaid.min.js"></script>
    <script>
      mermaid.initialize({ startOnLoad: true, theme: 'base' });
    </script>
    <style>
      body {
        @apply bg-github-dark text-white;
      }
      .mermaid {
        @apply bg-white text-black p-4 rounded-lg my-6;
      }
      .mermaid .mermaidSVG {
        @apply bg-white;
      }
      code {
        @apply bg-gray-800 text-yellow-100 px-1.5 py-0.5 rounded;
      }
      pre code {
        @apply block p-4 rounded-lg overflow-x-auto text-sm;
      }
      .copy-btn {
        @apply absolute top-2 right-2 bg-gray-700 hover:bg-gray-600 text-xs text-white px-2 py-1 rounded opacity-0 transition;
      }
      .code-block:hover .copy-btn {
        @apply opacity-100;
      }
      .code-block {
        @apply relative;
      }
      .exam-card {
        @apply border border-gray-700 rounded-xl p-6 transition cursor-pointer;
      }
      .exam-card:hover {
        @apply border-blue-500;
      }
      /* Typography overrides for dark mode */
      .prose-invert {
        @apply text-gray-200;
      }
      .prose-invert h1,
      .prose-invert h2,
      .prose-invert h3,
      .prose-invert h4 {
        @apply text-white;
      }
      .prose-invert a {
        @apply text-blue-400 underline;
      }
      .prose-invert code {
        @apply bg-gray-800 text-yellow-100;
      }
      .prose-invert pre {
        @apply bg-gray-900;
      }
      .prose-invert blockquote {
        @apply border-l-2 border-blue-500 text-gray-400;
      }
      .prose-invert table {
        @apply border border-gray-700;
      }
      .prose-invert th {
        @apply bg-gray-800 text-white border border-gray-700;
      }
      .prose-invert td {
        @apply border border-gray-700 bg-gray-900/50;
      }
      .prose-invert ul,
      .prose-invert ol {
        @apply text-gray-300;
      }
      .prose-invert li {
        @apply mb-2;
      }
      .prose-invert hr {
        @apply border-gray-700;
      }
    </style>
  </head>
  <body class="antialiased min-h-screen flex flex-col">
    <main class="flex-grow container mx-auto px-4 py-8 max-w-5xl">
      <slot />
    </main>
    <footer class="border-t border-gray-700 bg-github-dark py-8 mt-auto">
      <div class="container mx-auto px-4">
        <p class="text-center text-gray-500 text-sm">
          &copy; {new Date().getFullYear()} GitHub Actions Study Hub. Built for certification prep.
          <br />
          Deployed on <a href="https://pages.cloudflare.com/" class="text-blue-400 hover:underline">Cloudflare Pages</a>.
        </p>
      </div>
    </footer>
  </body>
</html>
