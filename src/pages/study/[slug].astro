---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Nav from '../../components/Nav.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const entries = await getCollection('study');
  return entries.map((e) => ({ params: { slug: e.slug } }));
}

const { slug } = Astro.params;
const entries = await getCollection('study');
const entry = entries.find((e) => e.slug === slug);

if (!entry) {
  return Astro.redirect('/');
}

const { Content } = await entry.render();
---

<BaseLayout title={entry.data.title} module={entry.data.module}>
  <Nav entries={entries} />
  <article class="prose prose-invert prose-lg max-w-none">
    <h1 class="text-3xl font-bold text-white mb-2">{entry.data.title}</h1>
    <p class="text-gray-400 mb-8">{entry.data.description}</p>

    <div
      class="border border-gray-700 rounded-lg p-4 bg-gray-900/30 mb-8"
    >
      <p class="text-sm text-gray-400 mb-2">Module: {entry.data.module}</p>
      <a
        href="/"
        class="text-sm text-blue-400 hover:underline"
      >
        ← Back to all modules
      </a>
    </div>

    <Content />
  </article>
</BaseLayout>
