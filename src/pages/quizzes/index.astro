---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout title="Practice Quizzes" module="">
  <div class="max-w-3xl mx-auto">
    <h1 class="text-3xl font-bold text-white mb-8">Practice Quizzes <span class="text-blue-400">📝</span></h1>

    <p class="text-gray-400 mb-8">
      Quiz content will be added module-by-module. Each quiz includes answer explanations
      tied to the certification syllabus.
    </p>

    <div class="bg-gray-900/50 border border-gray-700 rounded-xl p-6">
      <h3 class="text-xl font-bold text-white mb-4">Coming Soon</h3>
      <ul class="text-gray-300 space-y-2 text-sm">
        <li>✅ Foundations Quiz</li>
        <li>⏳ Triggers & Scheduling Quiz</li>
        <li>⏳ Job Control Quiz</li>
        <li>⏳ Full Practice Exam (timed)</li>
      </ul>
    </div>
  </div>
</BaseLayout>
